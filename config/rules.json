[
  {"id": "RL-1", "enabled": true, "symptoms": ["crackle"],
   "when_all": [{"item": "mic.clip_events", "verdict_in": ["warn", "bad"]}],
   "when_any": [],
   "text": "マイクの入力が大きすぎて、波形が割れている可能性",
   "evidence": ["mic.clip_events", "mic.peak_dbfs"]},
  {"id": "RL-2", "enabled": true, "symptoms": ["quiet", "muffled"],
   "when_all": [{"item": "mic.speech_level_dbfs", "verdict_in": ["warn", "bad"]}],
   "when_any": [],
   "text": "マイクの入力レベルが低く、声が小さく届いている可能性",
   "evidence": ["mic.speech_level_dbfs"]},
  {"id": "RL-3", "enabled": true, "symptoms": ["noise"],
   "when_all": [{"item_any": ["mic.noise_floor_dbfs", "mic.snr_db"],
                 "verdict_in": ["warn", "bad"]}],
   "when_any": [],
   "text": "周囲の音または機器のノイズが大きい可能性",
   "evidence": ["mic.noise_floor_dbfs", "mic.snr_db"]},
  {"id": "RL-4", "enabled": true, "symptoms": ["quiet", "muffled", "noise"],
   "when_all": [],
   "when_any": [{"item": "mic.all_zero", "value_in": [true]},
                {"item_any": ["priv.mic_machine", "priv.mic_user", "priv.mic_discord"],
                 "value_in": ["Deny"]}],
   "text": "マイクの音が Windows から入っていない(ミュート・プライバシー設定・デバイス違い)可能性",
   "evidence": ["mic.all_zero", "priv.mic_machine", "priv.mic_user", "priv.mic_discord"]},
  {"id": "RL-5", "enabled": true, "symptoms": ["drop"],
   "when_all": [{"item_any": ["net.gw.rtt_p95_ms", "net.gw.jitter_ms", "net.gw.fail_pct"],
                 "verdict_in": ["warn", "bad"]},
                {"item_all": ["net.ref.rtt_p95_ms", "net.ref.jitter_ms", "net.ref.fail_pct"],
                 "verdict_in": ["ok"]}],
   "when_any": [],
   "text": "Discord への経路の遅延や揺れが大きい可能性",
   "evidence": ["net.gw.rtt_p95_ms", "net.gw.jitter_ms", "net.gw.fail_pct",
                "net.ref.rtt_p95_ms", "net.ref.jitter_ms", "net.ref.fail_pct"]},
  {"id": "RL-6", "enabled": true, "symptoms": ["drop"],
   "when_all": [{"item_any": ["net.gw.rtt_p95_ms", "net.gw.jitter_ms", "net.gw.fail_pct"],
                 "verdict_in": ["warn", "bad"]},
                {"item_any": ["net.ref.rtt_p95_ms", "net.ref.jitter_ms", "net.ref.fail_pct"],
                 "verdict_in": ["warn", "bad"]}],
   "when_any": [],
   "text": "自宅の回線または Wi-Fi の遅延や揺れが大きい可能性",
   "evidence": ["net.gw.rtt_p95_ms", "net.gw.jitter_ms", "net.gw.fail_pct",
                "net.ref.rtt_p95_ms", "net.ref.jitter_ms", "net.ref.fail_pct"]},
  {"id": "RL-7", "enabled": true, "symptoms": ["drop", "crackle"],
   "when_all": [{"item_any": ["sys.cpu_avg_pct", "sys.cpu_max_pct", "sys.mem_load_pct"],
                 "verdict_in": ["warn", "bad"]}],
   "when_any": [],
   "text": "PC の負荷が高く、音声の処理が間に合っていない可能性",
   "evidence": ["sys.cpu_avg_pct", "sys.cpu_max_pct", "sys.mem_load_pct"]},
  {"id": "RL-8", "enabled": true, "symptoms": ["duck", "other_side"],
   "when_all": [{"item": "duck.pref", "value_in": [0, 1, 2]}],
   "when_any": [],
   "text": "Windows の通信時の音量調整(ダッキング)が有効で、通話中に他の音が小さくなる可能性",
   "evidence": ["duck.pref"]},
  {"id": "RL-9", "enabled": false, "symptoms": ["echo"],
   "when_all": [{"item": "echo.tone_in_mic_dbfs", "verdict_in": ["warn", "bad"]}],
   "when_any": [],
   "text": "スピーカーの音がマイクに回り込んでいる可能性",
   "evidence": ["echo.tone_in_mic_dbfs"]},
  {"id": "RL-10", "enabled": true, "symptoms": ["other_side", "crackle"],
   "when_all": [{"item": "tone.heard", "value_in": ["crackle"]}],
   "when_any": [],
   "text": "出力側(スピーカー・ヘッドホン・ドライバー)で音が割れている可能性",
   "evidence": ["tone.heard"]},
  {"id": "RL-11", "enabled": true, "symptoms": ["other_side", "quiet"],
   "when_all": [{"item": "tone.heard", "value_in": ["none"]}],
   "when_any": [],
   "text": "出力デバイスの選択が違うか、音が出ていない可能性",
   "evidence": ["tone.heard"]},
  {"id": "RL-12", "enabled": false, "symptoms": ["muffled"],
   "when_all": [],
   "when_any": [],
   "text": "Bluetooth ヘッドセットが通話用の接続に切り替わり、音質が下がっている可能性",
   "evidence": []}
]
